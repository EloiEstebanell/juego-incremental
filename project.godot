config_version=5

[application]
config/name="Asuntos pendientes · Oficina incremental"
run/main_scene="res://scenes/desk.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
viewport/transparent_background=false

environment/defaults/default_clear_color=Color(0.075, 0.11, 0.12, 1)
